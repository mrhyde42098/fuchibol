NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
TOKEN_SECRET=change-me-to-a-random-64-char-secret-in-production
CACHE_CHANNELS_TTL_MS=600000
CACHE_AGENDA_TTL_MS=300000
TOKEN_TTL_MS=900000
STREAM_RESOLVE_CACHE_MS=60000
LOG_LEVEL=info

# Upstream header profiles (adjust per source domain)
PROFILE_STREAM_XHD_ORIGIN=https://stream-xhd.com
PROFILE_STREAM_XHD_REFERER=https://stream-xhd.com/
PROFILE_PELOTALIBRE_ORIGIN=https://pelotalibrestv.org
PROFILE_PELOTALIBRE_REFERER=https://pelotalibrestv.org/
PROFILE_LA18HD_ORIGIN=https://la18hd.com
PROFILE_LA18HD_REFERER=https://la18hd.com/
PROFILE_TVTVHD_ORIGIN=https://tvtvhd.com
PROFILE_TVTVHD_REFERER=https://tvtvhd.com/
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Optional bootstrap fallback paths (relative to project root)
FALLBACK_CHANNELS_PATH=golea-analysis/channels.json
FALLBACK_AGENDA_PATH=golea-analysis/agenda.json

# Stream quality auditor (background ping + m3u8 validation)
STREAM_AUDIT_ENABLED=true
STREAM_AUDIT_PRIORITY_INTERVAL_MS=90000
STREAM_AUDIT_BACKGROUND_INTERVAL_MS=45000
STREAM_AUDIT_BACKGROUND_BATCH=6
STREAM_AUDIT_CONCURRENCY=3
STREAM_AUDIT_TIMEOUT_MS=12000
STREAM_AUDIT_DEGRADED_MS=4000
STREAM_AUDIT_FAIL_THRESHOLD=3
