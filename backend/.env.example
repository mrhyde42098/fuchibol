NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
TOKEN_SECRET=change-me-to-a-random-64-char-secret-in-production
CACHE_CHANNELS_TTL_MS=600000
CACHE_AGENDA_TTL_MS=90000
TOKEN_TTL_MS=7200000
STREAM_RESOLVE_CACHE_MS=60000
LOG_LEVEL=info

# Servidor en tu PC (un solo puerto: web + API)
# Iniciar-Fuchibol.bat pone SERVE_FRONTEND=true automáticamente
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../frontend/dist

# Rate limiting (peticiones por minuto por IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_STREAM_MAX=40
RATE_LIMIT_PROXY_MAX=600
RATE_LIMIT_PROBE_MAX=20

# Upstream header profiles
PROFILE_STREAM_XHD_ORIGIN=https://stream-xhd.com
PROFILE_STREAM_XHD_REFERER=https://stream-xhd.com/
PROFILE_PELOTALIBRE_ORIGIN=https://pelotalibrestv.org
PROFILE_PELOTALIBRE_REFERER=https://pelotalibrestv.org/
PROFILE_LA18HD_ORIGIN=https://la18hd.com
PROFILE_LA18HD_REFERER=https://la18hd.com/
PROFILE_TVTVHD_ORIGIN=https://tvtvhd.com
PROFILE_TVTVHD_REFERER=https://tvtvhd.com/
PROFILE_THETVAPP_ORIGIN=https://thetvapp.to
PROFILE_THETVAPP_REFERER=https://thetvapp.to/
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# IPTV-org mirrors (fallback HLS cuando fallan scrapers)
IPTV_MIRROR_ENABLED=true
IPTV_MIRROR_CACHE_MS=21600000
IPTV_MIRROR_TIMEOUT_MS=15000
IPTV_MIRROR_MAX_PER_CHANNEL=4
# Playlists extra (coma-separadas) — por defecto sports + LATAM + spa de iptv-org
# IPTV_MIRROR_PLAYLIST_URLS=https://iptv-org.github.io/iptv/categories/sports.m3u

FALLBACK_CHANNELS_PATH=golea-analysis/channels.json
FALLBACK_AGENDA_PATH=golea-analysis/agenda.json

# Auditor de señal (actualiza estado live/offline en segundo plano)
STREAM_AUDIT_ENABLED=true
STREAM_AUDIT_PRIORITY_INTERVAL_MS=90000
STREAM_AUDIT_BACKGROUND_INTERVAL_MS=60000
STREAM_AUDIT_BACKGROUND_BATCH=5
STREAM_AUDIT_CONCURRENCY=3
STREAM_AUDIT_TIMEOUT_MS=12000
STREAM_AUDIT_DEGRADED_MS=4000
STREAM_AUDIT_FAIL_THRESHOLD=3
STREAM_AUDIT_BACKOFF_MS=600000

# TheSportsDB — agenda en vivo
THESPORTSDB_ENABLED=true
THESPORTSDB_API_KEY=3
THESPORTSDB_CACHE_MS=180000
THESPORTSDB_TIMEOUT_MS=12000
THESPORTSDB_REQUEST_DELAY_MS=700
THESPORTSDB_MINIMAL_MODE=true
